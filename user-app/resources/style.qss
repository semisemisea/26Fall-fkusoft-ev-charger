/* 充电用户端全局样式表：基础控件、手机壳结构、排版角色、卡片、杂项控件 */
/* 色板对齐 Ant Design：primary #1677ff / success #52c41a / warning #faad14 / error #ff4d4f */

/* ===== 基础 ===== */
* {
    font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", "WenQuanYi Micro Hei", sans-serif;
}
QWidget {
    font-size: 14px;
    color: rgba(0, 0, 0, 0.88);
}
QMainWindow, QDialog {
    background: #f5f5f5;
}
QLabel {
    background: transparent;
}
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
QLineEdit {
    background: white;
    border: 1px solid #d9d9d9;
    border-radius: 10px;
    padding: 10px 12px;
}
QLineEdit:focus {
    border-color: #1677ff;
}
QListWidget {
    background: white;
    border: 1px solid #d9d9d9;
    border-radius: 10px;
}

/* ===== 按钮 ===== */
QPushButton {
    background: white;
    border: 1px solid #d9d9d9;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 15px;
}
QPushButton:hover {
    border-color: #4096ff;
    color: #4096ff;
}
QPushButton:pressed {
    border-color: #0958d9;
    color: #0958d9;
    background: #e6f4ff;
}
QPushButton:disabled {
    color: rgba(0, 0, 0, 0.25);
    border-color: #d9d9d9;
    background: rgba(0, 0, 0, 0.04);
}
QPushButton#primaryButton {
    background: #1677ff;
    color: white;
    border: none;
    font-weight: bold;
}
QPushButton#primaryButton:hover {
    background: #4096ff;
    color: white;
}
QPushButton#primaryButton:pressed {
    background: #0958d9;
    color: white;
}
QPushButton#dangerButton {
    background: #ff4d4f;
    color: white;
    border: none;
    font-weight: bold;
    font-size: 16px;
    padding: 12px;
}
QPushButton#dangerButton:hover {
    background: #ff7875;
    color: white;
}
QPushButton#dangerButton:pressed {
    background: #d9363e;
    color: white;
}
QPushButton#warnButton {
    background: #faad14;
    color: white;
    border: none;
    font-weight: bold;
}
QPushButton#warnButton:hover {
    background: #ffc53d;
    color: white;
}
QPushButton#warnButton:pressed {
    background: #d48806;
    color: white;
}
QPushButton#outlineDangerButton {
    background: white;
    color: #ff4d4f;
    border: 1px solid #ff4d4f;
    font-weight: bold;
}
QPushButton#outlineDangerButton:hover {
    color: #ff7875;
    border-color: #ff7875;
    background: white;
}
QPushButton#outlineDangerButton:pressed {
    color: #d9363e;
    border-color: #d9363e;
    background: #fff2f0;
}
QPushButton#roundBackButton {
    background: white;
    color: rgba(0, 0, 0, 0.88);
    border: 1px solid #d9d9d9;
    border-radius: 18px;
    font-size: 18px;
    font-weight: bold;
    padding: 0;
}
QPushButton#roundBackButton:hover {
    border-color: #1677ff;
    color: #1677ff;
}
QPushButton#roundBackButton:pressed {
    background: #e6f4ff;
}
QPushButton#roundStartButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #52c41a, stop:1 #389e0d);
    color: white;
    border: none;
    border-radius: 75px;
    font-size: 22px;
    font-weight: bold;
}
QPushButton#roundStartButton:hover {
    background: #52c41a;
    border: none;
    color: white;
}
QPushButton#roundStartButton:pressed {
    background: #389e0d;
    color: white;
}
QPushButton#roundStartButton:disabled {
    background: #b7eb8f;
}
QPushButton#compactButton {
    padding: 8px 16px;
}
QPushButton#reserveButton {
    padding: 4px 10px;
    color: #1677ff;
}
QPushButton#chargeButton {
    padding: 4px 14px;
}
QPushButton#aiBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e6f4ff, stop:1 #f9f0ff);
    color: #1677ff;
    border: 1px solid #d6e4ff;
    border-radius: 10px;
    padding: 9px 12px;
    text-align: left;
}
QPushButton#iconGhost {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
}

/* ===== 手机壳结构 ===== */
QFrame#statusBar {
    background: rgba(245, 245, 245, 0.82);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}
QFrame#tabPill {
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 1);
    border-radius: 26px;
}
QToolButton#tabBarButton {
    background: transparent;
    border: none;
    border-radius: 0;
    color: rgba(0, 0, 0, 0.45);
    font-size: 11px;
    padding: 4px 0;
}
QToolButton#tabBarButton:checked {
    color: #1677ff;
    font-weight: bold;
}
QToolButton#tabBarButton:hover {
    background: transparent;
    color: #1677ff;
}
QLabel#statusTime {
    font-size: 12px;
    font-weight: bold;
    color: rgba(0, 0, 0, 0.88);
}
QLabel#statusGlyph {
    font-size: 11px;
}

/* ===== 排版角色 ===== */
QLabel#pageHeading {
    font-size: 22px;
    font-weight: bold;
}
QLabel#pageTitle {
    font-size: 18px;
    font-weight: bold;
}
QLabel#heroTitle {
    font-size: 20px;
    font-weight: bold;
}
QLabel#cardHeading {
    font-size: 16px;
    font-weight: bold;
}
QLabel#cardTitle {
    font-size: 15px;
    font-weight: bold;
}
QLabel#strong {
    font-weight: bold;
}
QLabel#muted {
    color: rgba(0, 0, 0, 0.45);
}
QLabel#meta {
    color: rgba(0, 0, 0, 0.45);
    font-size: 12px;
}
QLabel#faint {
    color: rgba(0, 0, 0, 0.25);
    font-size: 11px;
}
QLabel#error {
    color: #ff4d4f;
}
QLabel#price {
    color: #ff4d4f;
    font-weight: bold;
}
QLabel#amountRed {
    color: #ff4d4f;
    font-size: 16px;
    font-weight: bold;
}
QLabel#totalAmount {
    color: #ff4d4f;
    font-size: 26px;
    font-weight: bold;
}
QLabel#balance {
    color: #1677ff;
    font-size: 28px;
    font-weight: bold;
}
QLabel#countdown {
    color: #1677ff;
    font-size: 34px;
    font-weight: bold;
}
QLabel#bigNumber {
    font-size: 34px;
    font-weight: bold;
}
QLabel#routeInfo {
    color: #1677ff;
}
QLabel#linkBlue {
    color: #1677ff;
    text-decoration: underline;
}
QLabel#statusStrong {
    font-weight: bold;
}
QLabel#badge {
    color: white;
    border-radius: 6px;
    padding: 2px 8px;
}
QLabel#prepareIcon {
    font-size: 52px;
}
QLabel#heroIcon {
    font-size: 64px;
}
QLabel#heroIconSmall {
    font-size: 56px;
}
QLabel#reservationStation {
    font-size: 17px;
    font-weight: bold;
}

/* ===== 卡片 ===== */
QFrame#infoCard {
    background: white;
    border: 1px solid #f0f0f0;
    border-radius: 14px;
}
QFrame#infoCard QLabel {
    border: none;
}
QFrame#profileCard {
    background: white;
    border: 1px solid #f0f0f0;
    border-radius: 18px;
}
QFrame#profileCard QLabel {
    border: none;
}
QFrame#chargerRow {
    background: white;
    border: 1px solid #f0f0f0;
    border-radius: 10px;
}
QFrame#chargerRow QLabel {
    border: none;
}
QFrame#receiptCard {
    background: white;
    border: 1px dashed #d9d9d9;
    border-radius: 14px;
}
QFrame#receiptCard QLabel {
    border: none;
}
QFrame#profileHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1677ff, stop:1 #69b1ff);
    border: none;
    border-radius: 18px;
}
QFrame#profileHeader QLabel {
    border: none;
    background: transparent;
}
QFrame#menuCard {
    background: white;
    border: 1px solid #f0f0f0;
    border-radius: 18px;
}
QFrame#menuCard QPushButton {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 14px 16px;
    text-align: left;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.88);
}
QFrame#menuCard QPushButton:hover {
    background: rgba(0, 0, 0, 0.04);
    color: rgba(0, 0, 0, 0.88);
}
QLabel#profileName {
    font-size: 18px;
    font-weight: bold;
    color: white;
}
QLabel#profilePhone {
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
}

/* ===== 电站卡片 ===== */
StationCard {
    background: white;
    border: 1px solid #f0f0f0;
    border-radius: 14px;
}
StationCard:hover {
    border-color: #1677ff;
}
StationCard QLabel {
    border: none;
    background: transparent;
}
StationCard QPushButton#navMini {
    color: #1677ff;
    background: #e6f4ff;
    border: none;
    border-radius: 6px;
    padding: 3px 9px;
    font-weight: bold;
}

/* ===== 下拉框弹层 ===== */
QListView#comboPopup {
    background: white;
    border: 1px solid #f0f0f0;
    border-radius: 10px;
    padding: 4px;
    outline: 0;
}

/* ===== 轻提示 ===== */
QFrame#toast {
    background: white;
    border: 1px solid #f0f0f0;
    border-radius: 10px;
}
QLabel#toastText {
    border: none;
}
QLabel#toastDot {
    border: none;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}
