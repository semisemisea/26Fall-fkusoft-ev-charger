/* 充电用户端全局样式表：基础控件、手机壳结构、排版角色、卡片、杂项控件 */

/* ===== 基础 ===== */
* {
    font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", "WenQuanYi Micro Hei", sans-serif;
}
QWidget {
    font-size: 14px;
    color: #26282b;
}
QMainWindow, QDialog {
    background: #f2f4f8;
}
QLabel {
    background: transparent;
}
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
QLineEdit {
    background: white;
    border: 1px solid #dcdfe6;
    border-radius: 10px;
    padding: 10px 12px;
}
QLineEdit:focus {
    border-color: #1d5cff;
}
QListWidget {
    background: white;
    border: 1px solid #e8eaee;
    border-radius: 10px;
}

/* ===== 按钮 ===== */
QPushButton {
    background: white;
    border: 1px solid #dcdfe6;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 15px;
}
QPushButton:hover {
    border-color: #1d5cff;
}
QPushButton:pressed {
    background: #eef3ff;
}
QPushButton:disabled {
    color: #a8adb5;
    border-color: #e4e6ea;
    background: #f5f6f8;
}
QPushButton#primaryButton {
    background: #1d5cff;
    color: white;
    border: none;
    font-weight: bold;
}
QPushButton#primaryButton:hover {
    background: #1a4fe0;
}
QPushButton#primaryButton:pressed {
    background: #1645c4;
}
QPushButton#dangerButton {
    background: #e74c3c;
    color: white;
    border: none;
    font-weight: bold;
    font-size: 16px;
    padding: 12px;
}
QPushButton#dangerButton:hover {
    background: #d63a2a;
}
QPushButton#warnButton {
    background: #e67e22;
    color: white;
    border: none;
    font-weight: bold;
}
QPushButton#outlineDangerButton {
    background: white;
    color: #e74c3c;
    border: 1px solid #e74c3c;
    font-weight: bold;
}
QPushButton#roundBackButton {
    background: white;
    color: #26282b;
    border: 1px solid #dcdfe6;
    border-radius: 18px;
    font-size: 18px;
    font-weight: bold;
    padding: 0;
}
QPushButton#roundBackButton:hover {
    border-color: #1d5cff;
    color: #1d5cff;
}
QPushButton#roundBackButton:pressed {
    background: #eef3ff;
}
QPushButton#roundStartButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2ecc71, stop:1 #27ae60);
    color: white;
    border: none;
    border-radius: 75px;
    font-size: 22px;
    font-weight: bold;
}
QPushButton#roundStartButton:hover {
    background: #2ecc71;
    border: none;
}
QPushButton#roundStartButton:pressed {
    background: #1f8b4d;
}
QPushButton#roundStartButton:disabled {
    background: #95d5b2;
}
QPushButton#compactButton {
    padding: 8px 16px;
}
QPushButton#reserveButton {
    padding: 4px 10px;
    color: #1d5cff;
}
QPushButton#chargeButton {
    padding: 4px 14px;
}
QPushButton#aiBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #eef3ff, stop:1 #f6f0ff);
    color: #1d5cff;
    border: 1px solid #d8e2ff;
    border-radius: 10px;
    padding: 9px 12px;
    text-align: left;
}
QPushButton#iconGhost {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
}

/* ===== 手机壳结构 ===== */
QFrame#statusBar {
    background: rgba(242, 244, 248, 0.82);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}
QFrame#tabPill {
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 1);
    border-radius: 26px;
}
QToolButton#tabBarButton {
    background: transparent;
    border: none;
    border-radius: 0;
    color: #8a8f99;
    font-size: 11px;
    padding: 4px 0;
}
QToolButton#tabBarButton:checked {
    color: #1d5cff;
    font-weight: bold;
}
QToolButton#tabBarButton:hover {
    background: transparent;
    color: #1d5cff;
}
QLabel#statusTime {
    font-size: 12px;
    font-weight: bold;
    color: #26282b;
}
QLabel#statusGlyph {
    font-size: 11px;
}

/* ===== 排版角色 ===== */
QLabel#pageHeading {
    font-size: 22px;
    font-weight: bold;
}
QLabel#pageTitle {
    font-size: 18px;
    font-weight: bold;
}
QLabel#heroTitle {
    font-size: 20px;
    font-weight: bold;
}
QLabel#cardHeading {
    font-size: 16px;
    font-weight: bold;
}
QLabel#cardTitle {
    font-size: 15px;
    font-weight: bold;
}
QLabel#strong {
    font-weight: bold;
}
QLabel#muted {
    color: #8a8f99;
}
QLabel#meta {
    color: #8a8f99;
    font-size: 12px;
}
QLabel#faint {
    color: #8a8f99;
    font-size: 11px;
}
QLabel#error {
    color: #e74c3c;
}
QLabel#price {
    color: #e74c3c;
    font-weight: bold;
}
QLabel#amountRed {
    color: #e74c3c;
    font-size: 16px;
    font-weight: bold;
}
QLabel#totalAmount {
    color: #e74c3c;
    font-size: 26px;
    font-weight: bold;
}
QLabel#balance {
    color: #1d5cff;
    font-size: 28px;
    font-weight: bold;
}
QLabel#countdown {
    color: #1d5cff;
    font-size: 34px;
    font-weight: bold;
}
QLabel#bigNumber {
    font-size: 34px;
    font-weight: bold;
}
QLabel#routeInfo {
    color: #2a6fdb;
}
QLabel#linkBlue {
    color: #1d5cff;
    text-decoration: underline;
}
QLabel#statusStrong {
    font-weight: bold;
}
QLabel#badge {
    color: white;
    border-radius: 6px;
    padding: 2px 8px;
}
QLabel#prepareIcon {
    font-size: 52px;
}
QLabel#heroIcon {
    font-size: 64px;
}
QLabel#heroIconSmall {
    font-size: 56px;
}
QLabel#reservationStation {
    font-size: 17px;
    font-weight: bold;
}

/* ===== 卡片 ===== */
QFrame#infoCard {
    background: white;
    border: 1px solid #e8eaee;
    border-radius: 14px;
}
QFrame#infoCard QLabel {
    border: none;
}
QFrame#profileCard {
    background: white;
    border: 1px solid #e8eaee;
    border-radius: 18px;
}
QFrame#profileCard QLabel {
    border: none;
}
QFrame#chargerRow {
    background: white;
    border: 1px solid #e8eaee;
    border-radius: 10px;
}
QFrame#chargerRow QLabel {
    border: none;
}
QFrame#receiptCard {
    background: white;
    border: 1px dashed #d5d9e0;
    border-radius: 14px;
}
QFrame#receiptCard QLabel {
    border: none;
}
QFrame#profileHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1d5cff, stop:1 #4ca1ff);
    border: none;
    border-radius: 18px;
}
QFrame#profileHeader QLabel {
    border: none;
    background: transparent;
}
QFrame#menuCard {
    background: white;
    border: 1px solid #e8eaee;
    border-radius: 18px;
}
QFrame#menuCard QPushButton {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 14px 16px;
    text-align: left;
    font-size: 14px;
}
QFrame#menuCard QPushButton:hover {
    background: #f5f7fa;
}
QLabel#profileName {
    font-size: 18px;
    font-weight: bold;
    color: white;
}
QLabel#profilePhone {
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
}

/* ===== 电站卡片 ===== */
StationCard {
    background: white;
    border: 1px solid #e8eaee;
    border-radius: 14px;
}
StationCard:hover {
    border-color: #1d5cff;
}
StationCard QLabel {
    border: none;
    background: transparent;
}
StationCard QPushButton#navMini {
    color: #1d5cff;
    background: #eaf1ff;
    border: none;
    border-radius: 6px;
    padding: 3px 9px;
    font-weight: bold;
}

/* ===== 下拉框弹层 ===== */
QListView#comboPopup {
    background: white;
    border: 1px solid #e8eaee;
    border-radius: 10px;
    padding: 4px;
    outline: 0;
}
