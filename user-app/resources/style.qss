/* 充电用户端全局样式表：基础控件、手机壳结构、排版角色、卡片、杂项控件 */
/* 色板：Stripe 式靛蓝 #5f63f0 + 藏青中性色（ink #1e293b / mute #64748d / 冷灰面） */

/* ===== 基础 ===== */
* {
    font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", "WenQuanYi Micro Hei", sans-serif;
}
QWidget {
    font-size: 14px;
    color: #1e293b;
}
QMainWindow, QDialog {
    background: #f8fafc;
}
QLabel {
    background: transparent;
}
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
QLineEdit {
    background: white;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 12px;
}
QLineEdit:focus {
    border-color: #5f63f0;
}
QListWidget {
    background: white;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
}

/* ===== 按钮 ===== */
QPushButton {
    background: white;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 15px;
}
QPushButton:hover {
    border-color: #5f63f0;
    color: #5f63f0;
}
QPushButton:pressed {
    border-color: #4749c4;
    color: #4749c4;
    background: #eef0ff;
}
QPushButton:disabled {
    color: #94a3b8;
    border-color: #e2e8f0;
    background: #f1f5f9;
}
QPushButton#primaryButton {
    background: #5f63f0;
    color: white;
    border: none;
    font-weight: bold;
}
QPushButton#primaryButton:hover {
    background: #7b7ff5;
    color: white;
}
QPushButton#primaryButton:pressed {
    background: #4749c4;
    color: white;
}
QPushButton#dangerButton {
    background: #e11d48;
    color: white;
    border: none;
    font-weight: bold;
    font-size: 16px;
    padding: 12px;
}
QPushButton#dangerButton:hover {
    background: #f43f5e;
    color: white;
}
QPushButton#dangerButton:pressed {
    background: #be123c;
    color: white;
}
QPushButton#warnButton {
    background: #f59e0b;
    color: #451a03;
    border: none;
    font-weight: bold;
}
QPushButton#warnButton:hover {
    background: #fbbf24;
    color: #451a03;
}
QPushButton#warnButton:pressed {
    background: #d97706;
    color: #451a03;
}
QPushButton#outlineDangerButton {
    background: white;
    color: #e11d48;
    border: 1px solid #e11d48;
    font-weight: bold;
}
QPushButton#outlineDangerButton:hover {
    color: #f43f5e;
    border-color: #f43f5e;
    background: white;
}
QPushButton#outlineDangerButton:pressed {
    color: #be123c;
    border-color: #be123c;
    background: #fff1f2;
}
QPushButton#roundBackButton {
    background: white;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 18px;
    font-size: 18px;
    font-weight: bold;
    padding: 0;
}
QPushButton#roundBackButton:hover {
    border-color: #5f63f0;
    color: #5f63f0;
}
QPushButton#roundBackButton:pressed {
    background: #eef0ff;
}
QPushButton#roundStartButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #10b981, stop:1 #059669);
    color: white;
    border: none;
    border-radius: 75px;
    font-size: 22px;
    font-weight: bold;
}
QPushButton#roundStartButton:hover {
    background: #059669;
    border: none;
    color: white;
}
QPushButton#roundStartButton:pressed {
    background: #047857;
    color: white;
}
QPushButton#roundStartButton:disabled {
    background: #a7f3d0;
}
QPushButton#compactButton {
    padding: 8px 16px;
}
QPushButton#reserveButton {
    padding: 4px 10px;
    color: #4f52d9;
}
QPushButton#chargeButton {
    padding: 4px 14px;
}
QPushButton#aiBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #eef0ff, stop:1 #f5f3ff);
    color: #4f52d9;
    border: 1px solid #d9dcff;
    border-radius: 10px;
    padding: 9px 12px;
    text-align: left;
}
QPushButton#iconGhost {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
}

/* ===== 手机壳结构 ===== */
QFrame#statusBar {
    background: rgba(248, 250, 252, 0.85);
    border-bottom: 1px solid rgba(13, 37, 61, 0.06);
}
QFrame#tabPill {
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 1);
    border-radius: 26px;
}
QToolButton#tabBarButton {
    background: transparent;
    border: none;
    border-radius: 0;
    color: #64748d;
    font-size: 11px;
    padding: 4px 0;
}
QToolButton#tabBarButton:checked {
    color: #5f63f0;
    font-weight: bold;
}
QToolButton#tabBarButton:hover {
    background: transparent;
    color: #5f63f0;
}
QLabel#statusTime {
    font-size: 12px;
    font-weight: bold;
    color: #1e293b;
}
QLabel#statusGlyph {
    font-size: 11px;
}

/* ===== 排版角色 ===== */
QLabel#pageHeading {
    font-size: 22px;
    font-weight: bold;
}
QLabel#pageTitle {
    font-size: 18px;
    font-weight: bold;
}
QLabel#heroTitle {
    font-size: 20px;
    font-weight: bold;
}
QLabel#cardHeading {
    font-size: 16px;
    font-weight: bold;
}
QLabel#cardTitle {
    font-size: 15px;
    font-weight: bold;
}
QLabel#strong {
    font-weight: bold;
}
QLabel#muted {
    color: #64748d;
}
QLabel#meta {
    color: #64748d;
    font-size: 12px;
}
QLabel#faint {
    color: #94a3b8;
    font-size: 11px;
}
QLabel#error {
    color: #e11d48;
}
QLabel#price {
    color: #e11d48;
    font-weight: bold;
}
QLabel#amountRed {
    color: #e11d48;
    font-size: 16px;
    font-weight: bold;
}
QLabel#totalAmount {
    color: #e11d48;
    font-size: 26px;
    font-weight: bold;
}
QLabel#balance {
    color: #5f63f0;
    font-size: 28px;
    font-weight: bold;
}
QLabel#countdown {
    color: #5f63f0;
    font-size: 34px;
    font-weight: bold;
}
QLabel#bigNumber {
    font-size: 34px;
    font-weight: bold;
}
QLabel#routeInfo {
    color: #4f52d9;
}
QLabel#linkBlue {
    color: #4f52d9;
    text-decoration: underline;
}
QLabel#statusStrong {
    font-weight: bold;
}
QLabel#badge {
    border-radius: 6px;
    padding: 2px 8px;
}
QLabel#prepareIcon {
    font-size: 52px;
}
QLabel#heroIcon {
    font-size: 64px;
}
QLabel#heroIconSmall {
    font-size: 56px;
}
QLabel#reservationStation {
    font-size: 17px;
    font-weight: bold;
}

/* ===== 卡片 ===== */
QFrame#infoCard {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
}
QFrame#infoCard QLabel {
    border: none;
}
QFrame#profileCard {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
}
QFrame#profileCard QLabel {
    border: none;
}
QFrame#chargerRow {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}
QFrame#chargerRow QLabel {
    border: none;
}
QFrame#receiptCard {
    background: white;
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
}
QFrame#receiptCard QLabel {
    border: none;
}
QFrame#profileHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4749c4, stop:1 #5f63f0);
    border: none;
    border-radius: 18px;
}
QFrame#profileHeader QLabel {
    border: none;
    background: transparent;
}
QFrame#menuCard {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
}
QFrame#menuCard QPushButton {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 14px 16px;
    text-align: left;
    font-size: 14px;
    color: #1e293b;
}
QFrame#menuCard QPushButton:hover {
    background: #f1f5f9;
    color: #1e293b;
}
QLabel#profileName {
    font-size: 18px;
    font-weight: bold;
    color: white;
}
QLabel#profilePhone {
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
}

/* ===== 电站卡片 ===== */
StationCard {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
}
StationCard:hover {
    border-color: #5f63f0;
}
StationCard QLabel {
    border: none;
    background: transparent;
}
StationCard QPushButton#navMini {
    color: #4f52d9;
    background: #eef0ff;
    border: none;
    border-radius: 6px;
    padding: 3px 9px;
    font-weight: bold;
}

/* ===== 下拉框弹层 ===== */
QListView#comboPopup {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 4px;
    outline: 0;
}

/* ===== 轻提示 ===== */
QFrame#toast {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}
QLabel#toastText {
    border: none;
}
QLabel#toastDot {
    border: none;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}
